# PostgreSQL connection string (docker compose exposes postgres on localhost:5432)
DATABASE_URL=postgres://pulse:pulse@localhost:5432/pulse_link

# Public origin used to build short URLs and QR codes (no trailing slash)
BASE_URL=http://localhost:3000

PORT=3000

# all | api | redirect
APP_MODE=all

# false | true | comma-separated proxy IPs/CIDRs (Fastify trustProxy; hop counts not supported)
TRUST_PROXY=false

# Click buffer flush interval in milliseconds
CLICK_FLUSH_MS=1000

# development | production | test
NODE_ENV=development

# Separate database used by integration tests (tests that need it are skipped when unset)
TEST_DATABASE_URL=postgres://pulse:pulse@localhost:5432/pulse_link_test
