{
  "name": "pulse-link",
  "version": "0.1.0",
  "private": true,
  "description": "Pulse Link — short URL service with QR codes and real-time click stats",
  "type": "module",
  "engines": {
    "node": ">=20.19"
  },
  "scripts": {
    "dev": "tsx watch src/main.ts",
    "build": "tsc -p tsconfig.build.json",
    "start": "node dist/main.js",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "eslint .",
    "format": "prettier --write .",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "migrate": "tsx src/scripts/migrate.ts",
    "migrate:prod": "node dist/scripts/migrate.js"
  },
  "dependencies": {
    "@fastify/cookie": "^11.1.2",
    "@fastify/helmet": "^13.1.1",
    "@fastify/rate-limit": "^11.2.0",
    "@fastify/static": "^10.1.5",
    "fastify": "^5.12.5",
    "pg": "^8.23.1",
    "qrcode": "^1.5.4",
    "sqids": "^0.3.0",
    "ua-parser-js": "^1.0.41",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^20.19.43",
    "@types/pg": "^8.23.1",
    "@types/qrcode": "^1.5.6",
    "eslint": "^10.11.0",
    "eslint-config-prettier": "^10.1.8",
    "jsqr": "^1.4.0",
    "pngjs": "^5.0.0",
    "prettier": "^3.9.9",
    "tsx": "^4.23.15",
    "typescript": "~6.0",
    "typescript-eslint": "^8.71.0",
    "vitest": "^4.1.11"
  }
}
